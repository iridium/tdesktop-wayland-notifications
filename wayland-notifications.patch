+[[nodiscard]] bool HasLayerShell() {
+	static auto result = false;
+	static auto resolved = false;
+	if (resolved || !qApp || !IsWayland()) {
+		return result;
+	}
+	using namespace QNativeInterface;
+	const auto native = qApp->nativeInterface<QWaylandApplication>();
+	const auto display = native ? native->display() : nullptr;
+	if (!display) {
+		return result;
+	}
+	resolved = true;
+
+	static const auto listener = wl_registry_listener{
+		.global = [](
+				void *data,
+				wl_registry *,
+				uint32_t,
+				const char *interface,
+				uint32_t) {
+			if (interface && !strcmp(interface, "zwlr_layer_shell_v1")) {
+				*static_cast<bool*>(data) = true;
+			}
+		},
+		.global_remove = [](void *, wl_registry *, uint32_t) {},
+	};
+	const auto queue = wl_display_create_queue(display);
+	const auto wrapper = static_cast<wl_display*>(
+		wl_proxy_create_wrapper(display));
+	wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(wrapper), queue);
+	const auto registry = wl_display_get_registry(wrapper);
+	wl_registry_add_listener(registry, &listener, &result);
+	wl_display_roundtrip_queue(display, queue);
+	wl_registry_destroy(registry);
+	wl_proxy_wrapper_destroy(wrapper);
+	wl_event_queue_destroy(queue);
+	return result;
+}
+
