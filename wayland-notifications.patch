+void InitCustomWidget(not_null<QWidget*> widget, QRect display) {
+#ifdef TDESKTOP_USE_LAYER_SHELL_QT
+	if (!LayerShellSupported()) {
+		return;
+	}
+	widget->createWinId();
+	const auto window = widget->windowHandle();
+	if (!window) {
+		return;
+	}
+	const auto layer = LayerShellQt::Window::get(window);
+	layer->setLayer(LayerShellQt::Window::LayerOverlay);
+	layer->setScope(u"notification"_q);
+	layer->setExclusiveZone(0);
+	// Take keyboard focus only when clicked, for the quick reply field.
+	layer->setKeyboardInteractivity(
+		LayerShellQt::Window::KeyboardInteractivityOnDemand);
+	layer->setActivateOnShow(false);
+	if (const auto screen = QGuiApplication::screenAt(display.center())) {
+		window->setScreen(screen);
+		layer->setScreen(screen);
+	}
+#endif // TDESKTOP_USE_LAYER_SHELL_QT
