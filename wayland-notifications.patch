+bool PlaceCustomWidget(not_null<QWidget*> widget, QRect geometry) {
+#ifdef TDESKTOP_USE_LAYER_SHELL_QT
+	const auto layer = LayerWindow(widget);
+	if (!layer) {
+		return false;
+	}
+	const auto screen = layer->screen()
+		? layer->screen()
+		: widget->windowHandle()->screen();
+	if (!screen) {
+		return true;
+	}
+	// Anchor to the closest screen corner, so that the notification
+	// stays in place when its size changes or the screen is resized.
+	// The compositor already keeps layer surfaces off the panels.
+	using Anchor = LayerShellQt::Window::Anchor;
+	const auto area = screen->availableGeometry();
+	const auto left = geometry.x() - area.x();
+	const auto top = geometry.y() - area.y();
+	const auto right = area.x() + area.width() - geometry.x() - geometry.width();
+	const auto bottom = area.y() + area.height() - geometry.y() - geometry.height();
+	const auto toLeft = (left <= right);
+	const auto toTop = (top <= bottom);
+	layer->setAnchors(LayerShellQt::Window::Anchors()
+		| (toLeft ? Anchor::AnchorLeft : Anchor::AnchorRight)
+		| (toTop ? Anchor::AnchorTop : Anchor::AnchorBottom));
+	layer->setMargins(QMargins(
+		toLeft ? left : 0,
+		toTop ? top : 0,
+		toLeft ? 0 : right,
+		toTop ? 0 : bottom));
+	return true;
+#else // TDESKTOP_USE_LAYER_SHELL_QT
+	return false;
+#endif // !TDESKTOP_USE_LAYER_SHELL_QT
