+				RTLD_NODELETE)) {
+			LoadSymbol(lib, "wl_proxy_marshal_flags", result.proxyMarshalFlags);
+			LoadSymbol(lib, "wl_proxy_add_listener", result.proxyAddListener);
+			LoadSymbol(lib, "wl_proxy_destroy", result.proxyDestroy);
+			LoadSymbol(lib, "wl_proxy_get_version", result.proxyGetVersion);
+			LoadSymbol(lib, "wl_display_roundtrip", result.displayRoundtrip);
+			LoadSymbol(lib, "wl_registry_interface", result.registryInterface);
+		}
+		return result;
+	}();
